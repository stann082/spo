<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>spo</AssemblyName>
  </PropertyGroup>

  <!-- Build straight into artifacts\build so a local change can be tried with .\artifacts\build\spo.exe.
       No net10.0 subfolder; Debug and Release share the folder, the last build wins. Publishing
       keeps the default bin\ path for its self-contained intermediate build, which would
       otherwise drop a copy of the runtime in here and break the framework-dependent exe. -->
  <PropertyGroup Condition=" '$(_IsPublishing)' != 'true' ">
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Self-contained single file only when publishing. Plain builds (Debug or Release) stay
       framework-dependent, so they can share artifacts\build without leftover runtime files
       from one build breaking the other. -->
  <PropertyGroup Condition=" '$(_IsPublishing)' == 'true' ">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\core.csproj" />
  </ItemGroup>

</Project>
